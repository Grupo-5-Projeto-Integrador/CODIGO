# ============================================================
# backend/.env.example — Grupo 5 Flamboyant
#
# CENÁRIO A — Backend local (VSCode) + banco via Docker:
#   docker-compose up -d db
#   cd backend && go run main.go
#   DB_HOST=localhost
#   DB_PORT=5434        (porta exposta pelo container no host)
#
# CENÁRIO B — Stack completo via Docker Compose (recomendado):
#   docker-compose up --build
#   Variáveis já são injetadas pelo docker-compose.yml.
#   Não é necessário criar .env para este cenário.
#   DB_HOST=db          (nome do serviço no docker network)
#   DB_PORT=5432        (porta interna do container)
#
# NUNCA commite o arquivo .env real — apenas este .env.example.
# ============================================================

# ── Banco de dados ──────────────────────────────────────────
# Cenário A (backend local + Docker banco):
DB_HOST=localhost
DB_PORT=5434
# Cenário B (Docker Compose completo) usa DB_HOST=db e DB_PORT=5432

DB_USER=postgres
DB_PASSWORD=sua_senha_aqui
DB_NAME=jp_mall
DB_SSLMODE=disable

# ── Backend ─────────────────────────────────────────────────
BACKEND_PORT=3001

# ── Autenticação JWT ────────────────────────────────────────
JWT_SECRET=flamboyant_secret_key_troque_em_producao
JWT_EXPIRES_IN=24h

# ── E-mail SMTP (opcional) ──────────────────────────────────
# false = e-mails são apenas simulados (sem envio real)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=sua_senha_de_app
SMTP_FROM=sinistros@flamboyant.com.br
